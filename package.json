{
  "name": "ravenshallow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "corbeaux:essai": "vitest run --config vitest.essai.mts src/lib/corbeaux/en-base.essai.ts",
    "forum:essai": "vitest run --config vitest.essai.mts src/lib/forum/en-base.essai.ts",
    "points:essai": "vitest run --config vitest.essai.mts src/lib/points/en-base.essai.ts",
    "calendrier:essai": "vitest run --config vitest.essai.mts src/lib/calendrier/en-base.essai.ts",
    "cours:essai": "vitest run --config vitest.essai.mts src/lib/cours/en-base.essai.ts",
    "partenariat:essai": "vitest run --config vitest.essai.mts src/lib/partenariat/en-base.essai.ts",
    "grimoires:essai": "vitest run --config vitest.essai.mts src/lib/grimoires/en-base.essai.ts",
    "veille": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-veille.mjs src/lib/veille/ronde.ts --sans-envoi",
    "veille:envoyer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-veille.mjs src/lib/veille/ronde.ts",
    "veille:exemple": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-veille.mjs src/lib/veille/rapport/montrer.ts",
    "veille:essayer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-veille.mjs src/lib/veille/essayer.ts",
    "veille:essai": "vitest run --config vitest.essai.mts src/lib/veille/en-base.essai.ts",
    "courriel:verifier": "node scripts/verifier-courriel.mjs",
    "postinstall": "prisma generate",
    "base:importer": "node scripts/importer-dossiers.mjs",
    "base:migrer": "node scripts/migrer.mjs",
    "base:sauvegarder": "node scripts/sauvegarder-base.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^5.22.0",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "lucide-react": "^1.34.0",
    "next": "14.2.15",
