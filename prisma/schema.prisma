// Ravenshallow — schéma de la base.
//
// Le dossier d'admission (compte joueur + fiche élève), le registre des
// visages, la lecture des dossiers par l'administration, la Cérémonie du
// Miroir (répartition en maison), la boutique Bjornstav (la baguette) et la
// Tour aux Corbeaux (la messagerie entre joueurs).
//
// Des règles de ce schéma ne sont PAS exprimables en Prisma et vivent en
// SQL brut. Les rejouer depuis ce fichier seul les perdrait :
//   `20260825200000_baguette_definitive` — la cohérence des trois colonnes de
//       la baguette, et son immuabilité une fois posée
//   `20260825210000_role_affiche`        — la cohérence des trois colonnes du
//       rôle affiché, et la propreté de son texte
//   `20260825220000_etat_maison_baguette` — l'accord entre chaque état et sa
//       valeur, et le refus d'inscrire une baguette à un compte non concerné
//   `20260826100000_tour_aux_corbeaux`   — l'accord entre le type d'une
//       conversation et sa clé, **le type qui ne change jamais**, le corps
//       d'un message qui n'est ni vide ni démesuré, et la copie figée d'un
//       signalement, qui ne se réécrit pas
//   `20260826110000_pouvoirs`            — l'accord entre une permission et sa
//       portée, et l'unicité d'une permission sans maison — que Postgres ne
//       garantit PAS tout seul, deux NULL lui étant distincts
//   `20260827160000_retirer_scenes_et_posts` — la cohérence des trois colonnes
//       d'une scène retirée, et le fait qu'une place gardée n'a de sens que
//       sur un post retiré
//   `20260827190100_points_a_la_main`     — l'accord entre la provenance d'un
//       point et son explication : motif et auteur obligatoires pour la main de
//       l'administration, interdits pour le reste
//   `20260827180000_carnet_des_points`    — une seule saison ouverte à la
//       fois, un seul point par post, l'accord entre la source d'un point et
//       son post, une ligne du carnet et un ajustement qui ne se réécrivent
//       jamais, et un classement archivé qui ne se réécrit pas du tout

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  Partie I — Le postulant (hors RP)
// ─────────────────────────────────────────────────────────────

/// Le compte de connexion. Une adresse = un élève (pas de pseudo joueur
/// séparé), d'où la relation 1–1 avec Eleve.
model Utilisateur {
  id             String @id @default(cuid())
  /// Identifiant de connexion. Stocké en minuscules par l'application.
  email          String @unique
  /// Hachage argon2id. Le mot de passe en clair ne quitte jamais la requête.
  motDePasseHash String

  /// Art. 2.3 — l'âge réel saisi n'est JAMAIS conservé : seul ce booléen
  /// atteste que le postulant a déclaré 16 ans ou plus.
  majeur16 Boolean

  role Role @default(JOUEUR)

  /// Horodatage de l'acceptation du règlement, posé côté serveur à la
  /// création du compte. `reglementVersion` sert aux évolutions annoncées
  /// dans le Grand Hall (préambule : entrée en vigueur à sept jours).
  reglementAccepteLe DateTime
  reglementVersion   String

  /// Droit d'accès courant au site. Indépendant du dossier d'admission :
  /// un membre validé de longue date peut être banni sans que sa candidature
  /// soit rejouée. Piloté depuis la liste des membres.
  ///   EN_ATTENTE      — pas d'accès à l'école
  ///   VALIDE          — accès total
  ///   EN_BANNISSEMENT — pas d'accès au forum, mais accès au bureau
  statutAcces StatutAcces @default(EN_ATTENTE)

  /// Incrémenté pour invalider d’un coup tous les liens d’accès envoyés par
  /// courriel : le jeton porte la version qu’il avait à l’émission.
  jetonVersion Int @default(0)

  /// Même principe pour les sessions ouvertes : le cookie porte la version
  /// qu’il avait à la connexion. Incrémenté au changement de mot de passe,
  /// il les ferme toutes d’un coup — y compris celle d’un intrus.
  sessionVersion Int @default(0)

  /// Fin de la suspension (art. 8, échelle des sanctions). Nulle pendant un
  /// bannissement, c’est une exclusion définitive (niveau 5) ; renseignée,
  /// c’est une suspension de 7 à 30 jours (niveau 4). Le motif, lui, vit
  /// dans le journal du membre : c’est la note écrite en bannissant.
  banniJusquau DateTime?

  /// Art. 15.4 — limites d'écriture. Facultatives, opposables à tous,
  /// affichées publiquement sur la fiche, jamais à justifier.
  limitesEcriture LimiteEcriture[] @default([])
  limitesAutres   String?

  /// Le jour de la dernière connexion réussie. **C'est ce qui rend
  /// l'article 7.3 applicable** : la base n'en gardait aucune trace, ni date
  /// de connexion ni date d'activité, et l'inactivité ne pouvait donc pas se
  /// constater. Nulle tant que le compte ne s'est jamais connecté.
  derniereConnexionLe DateTime?

  /// Art. 7.3 — le compte archivé après une longue absence.
  ///
  /// **Ce n'est pas une sanction, et cela ne touche pas à `statutAcces`** : un
  /// compte archivé n'est pas mis à la porte, il sort seulement de l'effectif
  /// de sa maison — sans quoi une maison à moitié absente serait pénalisée au
  /// tournoi par des joueurs qui ne jouent plus.
  ///
  /// « Le retour reste possible » (art. 7.3) : une connexion lève l'archivage
  /// d'elle-même. Les deux colonnes vont ensemble ou pas du tout, et c'est la
  /// base qui le tient.
  archiveLe  DateTime?
  archivePar String?

  /// **Un compte qui n'appartient à personne.** Aujourd'hui il n'y en a qu'un :
  /// celui de La Veille, qui se connecte chaque matin pour vérifier que les
  /// écrans s'affichent, et qui ne publie jamais rien.
  ///
  /// Il lui faut un dossier ACCEPTÉ pour ouvrir le bureau, le forum et les
  /// grimoires — et c'est précisément ce qui le rendait visible : le Registre
  /// liste tous les dossiers acceptés, et la recherche de la Tour aussi. Sur
  /// trois membres, un quatrième nommé « Veille » se remarque.
  ///
  /// **Cette colonne décide de quelque chose**, et de sept choses exactement :
  /// le Registre, la fiche publique, la recherche de correspondants, la liste
  /// des élèves à qui donner des points, le top du mois, l'effectif du
  /// tournoi, et la liste des passages d'année. Partout ailleurs — et
  /// notamment dans TOUTE la zone d'administration — le compte se voit comme
  /// les autres : l'administration doit savoir ce qui existe chez elle.
  ///
  /// ⚠️ **La condition s'écrit en toutes lettres dans chacune des sept
  /// requêtes**, jamais factorisée dans une constante. C'est le procédé du
  /// courrier du château (`AVEC_ADMINISTRATION`) : la sortir des `where` la
  /// rendrait invisible, et `veille/etancheite.test.ts` découpe les trois
  /// dépôts fonction par fonction pour vérifier qu'aucune ne l'oublie.
  ///
  /// ⚠️ **Ce n'est ni un rôle, ni une sanction, ni un statut d'accès.** Les
  /// droits viennent de `role` et de `statutAcces`, et rien ici ne les touche.
  compteDeService Boolean @default(false)

  eleve Eleve?

  /// Le fil de ce membre : décisions sur son dossier, modifications de sa
  /// fiche et de son accès.
  journal JournalMembre[] @relation("JournalDuMembre")

  /// Les entrées écrites PAR ce compte, quand il agit comme administrateur.
  decisionsPrises JournalMembre[] @relation("DecisionsPrises")

  reinitialisations JetonReinitialisation[]

  // ── La Tour aux Corbeaux ──
  /// Les fils où ce membre figure, et ce qu'il en a lu. La table est séparée
  /// pour que trois participants soient possibles un jour sans migration.
  participations        Participation[]
  conversationsOuvertes Conversation[]  @relation("ConversationsOuvertes")
  corbeauxEnvoyes       Message[]       @relation("CorbeauxEnvoyes")
  /// Ce qu'il a retiré de sa vue — ou ce qui ne lui est jamais parvenu.
  messagesMasques       MessageMasque[]
  blocagesPoses         Blocage[]       @relation("BlocagesPoses")
  blocagesSubis         Blocage[]       @relation("BlocagesSubis")
  signalementsEnvoyes   Signalement[]   @relation("SignalementsEnvoyes")
  signalementsRecus     Signalement[]   @relation("SignalementsRecus")

  // ── Les pouvoirs ──
  /// Les permissions accordées à la carte, indépendantes de `role`. Une ligne
  /// par maison pour les deux permissions de maison ; une seule, sans maison,
  /// pour les trois qui portent sur tout le forum.
  ///
  /// **Aucune ne touche à la Tour aux Corbeaux, et aucune ne le pourra** : la
  /// liste `Permission` n'en compte que cinq, et un test refuse la sixième.
  permissions PermissionAccordee[]

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@map("utilisateurs")
}

/// Droits sur le site. À ne pas confondre avec Fonction, qui décrit la place
/// du personnage dans l'école.
enum Role {
  JOUEUR
  MODERATEUR
  ADMIN
}

/// Accès accordé au membre. « Le bureau » est l'accueil des membres connectés,
/// pas encore construit : un membre en bannissement y garde accès, mais perd
/// le forum.
enum StatutAcces {
  EN_ATTENTE
  VALIDE
  EN_BANNISSEMENT
}

enum LimiteEcriture {
  DEUIL
  MALTRAITANCE
  NOYADE
  ENFERMEMENT
  EMPRISE_MENTALE
  BLESSURES_DECRITES
  HARCELEMENT
  ROMANCE
}

// ─────────────────────────────────────────────────────────────
//  Partie II — L'élève (fiche RP)
// ─────────────────────────────────────────────────────────────

/// La fiche de personnage. Elle porte aussi l'état du dossier d'admission :
/// tant qu'il n'est pas accepté, la fiche existe mais l'élève n'a accès ni
/// aux scènes ni aux cours.
model Eleve {
  id            String      @id @default(cuid())
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  /// Format « Prénom Nom » ou « Prénom I. Nom », validé par le schéma partagé.
  prenomNom String
  genre     Genre
  famille   Famille

  /// Art. 10.2 — 13 ans à l'entrée, affiché en dur et non modifiable côté
  /// joueur. L'administration l'ajuste ensuite depuis la liste des membres,
  /// notamment après un Rite de passage.
  age Int @default(13)

  /// L'année d'étude du personnage, et elle seule. Toujours renseignée, même
  /// pour la directrice : `roleAffiche` la masque à l'affichage, il ne
  /// l'efface pas.
  ///
  /// Les rôles du corps professoral sont attribués par l'administration seule
  /// (art. 13.5) — ils se posent maintenant dans `roleAffiche`.
  fonction Fonction @default(PREMIERE_ANNEE)

  /// Rôle particulier au château : « Directrice », « Professeur d'alchimie »,
  /// « Bibliothécaire », « Intendant ». Texte libre, parce que ces rôles sont
  /// rares, variés, et qu'on en inventera d'autres — les enfermer dans un enum
  /// obligerait à une migration par nouveau titre.
  ///
  /// **Purement décoratif.** Il REMPLACE l'année partout où elle s'affiche —
  /// une directrice n'est pas en troisième année — et n'ouvre RIEN, nulle
  /// part : aucun contrôle d'accès, aucun bouton d'administration, aucune
  /// permission ne le lit. Les droits viennent de `Utilisateur.statutAcces` et
  /// de l'état du dossier, jamais d'un libellé affiché. Écrire
  /// « Administratrice » ici n'ouvre pas une porte de plus.
  ///
  /// Nul = le membre est un élève de son année, et c'est l'année qui s'affiche.
  /// L'année reste stockée et modifiable dans les deux cas : elle est masquée,
  /// pas effacée.
  roleAffiche String?

  /// Quand le rôle a été posé, et par qui. Ce champ distingue publiquement un
  /// membre des autres : on doit pouvoir dire d'où il vient. Affiché côté
  /// administration seule.
  ///
  /// `roleAffichePosePar` vaut « Administration » tant que la zone
  /// d'administration n'est qu'un mot de passe partagé, sans comptes
  /// distincts : le site n'a personne d'autre à nommer.
  roleAffichePoseLe  DateTime?
  roleAffichePosePar String?

  portraitType PortraitType
  /// Renseigné uniquement si portraitType = ACTEUR.
  acteurNom    String?
  /// Image déjà recadrée en 9:16 côté client, **stockée ici même**, en
  /// texte encodé (`data:image/…;base64,…`) — celui de la directrice pèse
  /// 207 Ko. Le nom de la colonne dit « url » et le schéma a longtemps
  /// annoncé Vercel Blob : ni l'un ni l'autre n'a jamais été vrai.
  ///
  /// Elle ne se lit donc **jamais dans une requête de liste** : la route
  /// `/api/portraits/[id]` la sert comme une vraie image, et l'écran ne
  /// transporte qu'une adresse composée par `lib/ecole/portrait.ts`.
  portraitUrl  String?

  /// Minimum 700 signes — contrainte portée par le schéma Zod partagé,
  /// Postgres ne sachant pas exprimer une longueur minimale ici.
  biographie String @db.Text

  /// Trois champs séparés de part et d'autre : la séparation est volontaire
  /// (art. 10.5), elle force de vrais défauts.
  qualite1 String
  qualite2 String
  qualite3 String
  defaut1  String
  defaut2  String
  defaut3  String

  plusGrandePeur String

  /// Art. 10.4 — horodatage de la certification. Nul tant que non cochée.
  certification104Le DateTime?

  // ── État du dossier ──
  statut    StatutDossier @default(BROUILLON)
  soumisLe  DateTime?
  decideLe  DateTime?
  /// Note de l'administration, affichée au joueur en A_CORRIGER.
  noteAdmin String?       @db.Text

  visagePris VisagePris?

  // ── Les deux premiers pas : où ils en sont ──

  /// Où en est la répartition de ce compte.
  ///
  /// **Ne jamais déduire cet état de la présence d'une maison.** Une case
  /// vide ne dit pas la même chose selon les comptes : un nouvel élève doit
  /// être envoyé au Miroir, la directrice ne doit surtout pas l'être. C'est
  /// cette colonne qui tranche, et elle seule.
  ///
  ///   NON_FAIT   — le Miroir l'attend : to-do au bureau, adresse ouverte
  ///   FAIT       — il a parlé : la maison s'affiche et compte au tournoi
  ///   SANS_OBJET — ce compte n'est pas concerné : ni to-do, ni adresse, ni
  ///                blason, ni point de maison
  ///
  /// `SANS_OBJET` **n'efface rien** : la maison reste écrite dans sa colonne.
  /// Une joueuse de Tideål nommée directrice la retrouve intacte le jour où
  /// elle quitte le poste, sans repasser devant le Miroir.
  etatMaison EtatEtape @default(NON_FAIT)

  /// Même chose pour la boutique. Les deux états sont **indépendants** : on
  /// peut retirer la maison sans toucher à la baguette, et l'inverse.
  etatBaguette EtatEtape @default(NON_FAIT)

  // ── La baguette de Bjornstav — définitive ──
  /// Le bois, le cœur et le jour où l'échoppe les a inscrits. Nuls tant que
  /// l'élève n'est pas passé à Kaldvik.
  ///
  /// Les trois vont ensemble ou pas du tout, et **ne changent plus une fois
  /// posés** : ces deux règles sont portées par la base elle-même — une
  /// contrainte `CHECK` et un déclencheur — et non par une condition écrite
  /// dans le code, qui ne vaudrait que pour les chemins qui pensent à
  /// l'écrire. Voir la migration `20260825200000_baguette_definitive`.
  baguetteBois      BaguetteBois?
  baguetteCoeur     BaguetteCoeur?
  baguetteChoisieLe DateTime?

  // ── Le Miroir de Brume — art. 11.2, définitif ──
  /// La maison telle qu'elle s'affiche partout : bandeau, fiche, bureau.
  /// Nulle tant que le Miroir n'a pas parlé. La trace de la cérémonie qui
  /// l'a décidée vit à part, dans `CeremonieMiroir`.
  maison    Maison?
  repartiLe DateTime?
  ceremonie CeremonieMiroir?

  /// Ce que ce personnage a ouvert et écrit sur le forum. Ancré sur la fiche
  /// et non sur le compte : un post RP est écrit par un personnage.
  sujetsOuverts Sujet[] @relation("SujetsOuverts")
  postsEcrits   Post[]  @relation("PostsEcrits")

  /// Les maisons dont cet élève est préfet. Ancré sur la fiche et non sur le
  /// compte : être préfet est une charge du personnage, pas un droit du
  /// joueur — et c'est la maison de la fiche qu'on lit à côté.
  prefectures Prefet[]

  /// Les points de ce personnage — art. 18.1 et 18.2.
  ///
  /// **Posée avant ce qui l'écrira**, décision du joueur du 27 août 2026 : la
  /// carte de l'auteur, à gauche de chaque post, les affiche. Rien ne
  /// l'incrémente aujourd'hui — ni les cours, ni les événements —, et tout le
  /// monde est donc à zéro jusqu'au lot des points.
  ///
  /// ⚠️ **Le total d'une maison ne se lit jamais en sommant cette colonne.**
  /// `lib/ecole/tournoi.ts` est le seul endroit qui dit pour qui un compte
  /// marque : une somme naïve ramasserait la maison d'une directrice, qui
  /// reste écrite en base sous `SANS_OBJET`.
  points Int @default(0)

  /// Les lignes du carnet gagnées par ce personnage. **C'est la trace**, et
  /// `points` n'en est que le résumé : le jour où ce total serait faux, c'est
  /// d'ici qu'on le refera.
  pointsGagnes PointGagne[]

  /// Les mots qu'il a épinglés au tableau de sa maison. Ils lui survivent :
  /// le lien s'annule, le mot reste au mur.
  motsDuTableau MotDuTableau[]

  /// Ce qu'il a dit au salon de sa maison. Même sort : le lien s'annule, le
  /// message reste dans la pièce.
  messagesDeSalon MessageSalon[]

  /// Les contrôles de leçon qu'il a envoyés. Un seul par leçon, pour toujours
  /// (`REGLES.controleEnvoiUnique`), et la ligne lui survit comme celles du
  /// carnet : ce qui a été passé a été passé.
  controlesEnvoyes ControleEnvoye[]

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@index([statut, soumisLe])
  @@index([fonction])
  @@map("eleves")
}

/// Où en est une étape des premiers pas — ou si elle ne concerne pas ce compte.
///
/// Trois états et non deux, parce qu'une case vide est ambiguë : elle veut
/// dire « pas encore » pour un élève et « sans objet » pour un professeur, et
/// le site doit faire l'inverse dans les deux cas.
enum EtatEtape {
  NON_FAIT
  FAIT
  SANS_OBJET
}

enum Genre {
  FEMININ
  MASCULIN
  AUTRE
}

/// L'année d'étude, et rien d'autre. Sept années, conformément à la bible du
/// lore (§9).
///
/// `PROFESSEUR` et `DIRECTION` en ont été retirés : un rôle au château n'est
/// pas une année, et deux façons d'écrire « directrice » — par cette liste ou
/// par le texte libre — auraient fini par se contredire. Ils vivent désormais
/// dans `Eleve.roleAffiche`.
enum Fonction {
  PREMIERE_ANNEE
  DEUXIEME_ANNEE
  TROISIEME_ANNEE
  QUATRIEME_ANNEE
  CINQUIEME_ANNEE
  SIXIEME_ANNEE
  SEPTIEME_ANNEE
}

enum Famille {
  SORCIERS
  MIXTE
  PREMIER_LIGNEE
}

enum PortraitType {
  ACTEUR
  IA_ILLUSTRATION
}

enum StatutDossier {
  BROUILLON
  EN_ATTENTE
  ACCEPTE
  A_CORRIGER
  REFUSE
}

// ─────────────────────────────────────────────────────────────
//  La Cérémonie du Miroir — art. 11.1 et 11.2
// ─────────────────────────────────────────────────────────────

/// La nuit où le Miroir a lu un élève. Une par élève, jamais deux :
/// `eleveId @unique` fait porter cette règle par la base elle-même, plutôt
/// que par une condition qu'on pourrait un jour oublier d'écrire.
///
/// Ce que la ligne raconte, selon son état :
///   absente                   — la cérémonie n'a jamais été ouverte
///   présente, `closeLe` nulle — l'ordre des réponses est tiré, rien de plus
///   `closeLe` renseignée      — le Miroir a parlé, `Eleve.maison` est écrite
///
/// La maison et sa date ne sont pas ici : elles vivent sur `Eleve`, relues à
/// chaque page. Cette table-ci est la trace, gardée pour expliquer une
/// répartition au joueur qui la conteste — jamais pour la rejouer (art. 11.2).
model CeremonieMiroir {
  id      String @id @default(cuid())
  eleveId String @unique
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  /// L'ordre d'affichage des réponses, tiré côté serveur à la première
  /// ouverture et jamais rebattu — sans quoi les joueurs s'entendraient sur
  /// « prends toujours la dernière ». Cinq entrées, une par question, chacune
  /// listant les identifiants dans l'ordre d'affichage : « q1c q1a q1d q1b ».
  melange   String[]
  ouverteLe DateTime @default(now())

  /// Les cinq identifiants choisis, dans l'ordre des questions. C'est d'eux
  /// que la maison se recalcule : le résultat doit rester reproductible, sans
  /// quoi on ne pourrait rien répondre à un joueur qui conteste.
  reponses String[] @default([])

  /// Les points par maison, tels que comptés cette nuit-là. Recalculables
  /// aujourd'hui — mais le jour où le barème bougerait, seule cette trace
  /// dirait encore ce que l'élève a réellement obtenu.
  points Json?

  /// Renseignée à la révélation. C'est elle qui ferme la cérémonie.
  closeLe DateTime?

  @@map("ceremonies_miroir")
}

// ─────────────────────────────────────────────────────────────
//  Registre des visages — art. 6.3
// ─────────────────────────────────────────────────────────────

/// « Un même visage ne peut être utilisé que par un seul personnage à la
/// fois. » `nomNormalise` (minuscules, sans accents ni ponctuation) porte
/// l'unicité et sert à la vérification en direct pendant la saisie.
model VisagePris {
  id           String @id @default(cuid())
  /// Tel que saisi, pour l'affichage.
  nomActeur    String
  nomNormalise String @unique

  /// Nul si le visage est réservé par l'administration sans élève associé.
  eleveId String? @unique
  eleve   Eleve?  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  prisLe DateTime @default(now())

  @@map("visages_pris")
}

// ─────────────────────────────────────────────────────────────
//  Journal du membre
// ─────────────────────────────────────────────────────────────

/// Fil chronologique d'un membre : décisions d'administration sur son dossier,
/// et modifications ultérieures de sa fiche ou de son accès.
///
/// Ancré sur le compte et non sur la fiche : un bannissement sanctionne le
/// joueur. Sert à expliquer une décision (art. 8.2) et à permettre de la
/// contester dans les quinze jours (art. 8.5).
model JournalMembre {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation("JournalDuMembre", fields: [utilisateurId], references: [id], onDelete: Cascade)

  type EvenementMembre

  /// Valeurs avant/après, sérialisées en texte parce qu'un événement porte
  /// selon les cas un enum, un entier ou rien. Nulles pour une soumission.
  valeurAvant String?
  valeurApres String?

  /// Motif écrit par l'administration. Obligatoire pour un renvoi en
  /// correction, un refus et un bannissement — contrainte portée par le
  /// schéma Zod partagé, Postgres ne sachant pas la conditionner au type.
  note String? @db.Text

  /// Nul si l'auteur a été supprimé, ou si l'événement vient du joueur
  /// lui-même (soumission du dossier).
  parUtilisateurId String?
  parUtilisateur   Utilisateur? @relation("DecisionsPrises", fields: [parUtilisateurId], references: [id], onDelete: SetNull)

  /// Nom affiché de l'auteur, quand il n'a pas de compte : l'administration
  /// entre par simple mot de passe, et le site lui-même écrit certaines
  /// entrées (accusé de réception). Nul quand l'auteur est le joueur.
  parNom String?

  creeLe DateTime @default(now())

  @@index([utilisateurId, creeLe])
  @@map("journal_membres")
}

enum EvenementMembre {
  DOSSIER_SOUMIS
  FICHE_MODIFIEE
  DOSSIER_ACCEPTE
  DOSSIER_RENVOYE_EN_CORRECTION
  DOSSIER_REFUSE
  AGE_MODIFIE
  FONCTION_MODIFIEE
  ROLE_AFFICHE_MODIFIE
  ETAT_MAISON_MODIFIE
  ETAT_BAGUETTE_MODIFIE
  ACCES_MODIFIE
  COURRIEL_CONFIRMATION
  /// Le rôle technique — joueur, modérateur, administrateur. Distinct de
  /// `ACCES_MODIFIE` : suspendre un compte et le faire modérateur ne se lisent
  /// pas de la même façon, et deux valeurs qui se ressemblent dans un même
  /// enum finissent toujours par se confondre.
  ROLE_MODIFIE
  PERMISSION_ACCORDEE
  PERMISSION_RETIREE
  PREFET_NOMME
  PREFET_DEMIS

  /// Une scène retirée du forum par le staff, avec son motif.
  SCENE_SUPPRIMEE

  /// Art. 7.3 — le compte mis de côté après une longue absence, et son retour.
  /// Distincts d'`ACCES_MODIFIE` : archiver n'est pas sanctionner, et deux
  /// gestes qui se ressemblent dans un même enum finissent par se confondre.
  COMPTE_ARCHIVE
  COMPTE_RESTAURE
}

// ─────────────────────────────────────────────────────────────
//  Connexion — réinitialisation et limitation des tentatives
// ─────────────────────────────────────────────────────────────

/// Demande de réinitialisation du mot de passe.
///
/// Une ligne par lien envoyé. Le lien meurt au bout d’une heure, ne sert
/// qu’une fois (`utiliseLe`), et une nouvelle demande consomme les
/// précédentes — trois garanties qu’un jeton simplement signé, stocké nulle
/// part, ne pourrait pas offrir.
model JetonReinitialisation {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  /// SHA-256 du jeton envoyé. Le jeton en clair ne vit que dans le courriel :
  /// une base dérobée ne permet de réinitialiser aucun compte. SHA-256 suffit
  /// ici — le jeton est tiré au hasard sur 32 octets, il n’a rien de la faible
  /// entropie d’un mot de passe humain, qui exige argon2.
  jetonHash String @unique

  expireLe  DateTime
  /// Renseignée dès que le lien a servi.
  utiliseLe DateTime?

  creeLe DateTime @default(now())

  @@index([utilisateurId, creeLe])
  @@map("jetons_reinitialisation")
}

/// Échecs de connexion récents, pour ralentir puis bloquer les essais en série.
///
/// `cle` est une empreinte HMAC de l’adresse e-mail ou de l’adresse IP, jamais
/// leur valeur : la table sait qu’une même origine a échoué six fois, sans
/// savoir laquelle. Une connexion réussie efface les lignes de sa clé, et
/// celles de plus d’une heure sont balayées au passage.
model TentativeConnexion {
  id     String   @id @default(cuid())
  cle    String
  creeLe DateTime @default(now())

  @@index([cle, creeLe])
  @@map("tentatives_connexion")
}

// ─────────────────────────────────────────────────────────────
//  Les quatre maisons (bible du lore, §4)
// ─────────────────────────────────────────────────────────────

enum Maison {
  KALDRAFN
  NATTORM
  BRYGGELD
  TIDEAL
}

// ─────────────────────────────────────────────────────────────
//  La boutique Bjornstav (bible du lore, §5)
// ─────────────────────────────────────────────────────────────

/// Cinq bois, cinq cœurs, vingt-cinq baguettes possibles. Aucun n'apporte le
/// moindre avantage : la magie courante n'a ni coût ni risque dans ce lore,
/// un sort marche ou rate. La baguette est un signe, pas un équipement.

enum BaguetteBois {
  FRENE
  IF
  SORBIER
  BOULEAU
  CHENE_DES_TEMPETES
}

enum BaguetteCoeur {
  PLUME_DE_CORBEAU
  ECAILLE_ANGUILLE_ARGENTEE
  NERF_LOUP_DES_FJORDS
  GRIFFE_OURS_DES_CAVERNES
  CRISTAL_DE_GLACE
}

// ─────────────────────────────────────────────────────────────
//  La Tour aux Corbeaux — la messagerie entre joueurs (art. 3.6, 8.6)
// ─────────────────────────────────────────────────────────────

/// Un fil entre deux membres — ou entre un membre et l'Administration.
///
/// **Aucune colonne « destinataire ».** Les participants vivent dans une
/// table séparée : c'est ce qui laisse la porte ouverte à trois personnes ou
/// plus sans rien casser le jour venu. L'interface, elle, n'en propose que
/// deux dans ce lot.
model Conversation {
  id String @id @default(cuid())

  /// Entre deux membres, ou adressée au staff.
  ///
  /// **Ce champ ne change JAMAIS après la création** — un déclencheur le
  /// refuse. Sans ce verrou, basculer une conversation privée en
  /// `AVEC_ADMINISTRATION` la donnerait à lire au staff, ce que le site
  /// promet de ne jamais faire.
  type TypeConversation @default(ENTRE_MEMBRES)

  /// Les deux identifiants triés et collés — « idA:idB » —, ou
  /// « administration:idDuMembre ».
  ///
  /// C'est le verrou en base contre les fils en double : deux membres qui
  /// s'écrivent au même instant depuis deux onglets ne peuvent pas ouvrir
  /// deux conversations parallèles, où chacun croirait que l'autre se tait.
  /// Une contrainte, et non une condition dans le code, qui ne vaudrait que
  /// pour les chemins qui pensent à l'écrire.
  clePaire String @unique

  /// Qui l'a ouverte. C'est de cette colonne et de `creeLe` que l'anti-
  /// démarchage tire son compte (art. 3.6) : pas de table de compteurs.
  ouvertParId String?
  ouvertPar   Utilisateur? @relation("ConversationsOuvertes", fields: [ouvertParId], references: [id], onDelete: SetNull)

  /// Dénormalisé, et indexé : c'est le tri « par activité récente » de la
  /// liste des conversations. Le recalculer à chaque affichage obligerait à
  /// balayer tous les messages de tous les fils.
  dernierMessageLe DateTime @default(now())

  participations Participation[]
  messages       Message[]

  creeLe DateTime @default(now())

  @@index([dernierMessageLe])
  @@map("conversations")
}

enum TypeConversation {
  ENTRE_MEMBRES
  AVEC_ADMINISTRATION
}

/// Un membre dans un fil, et ce qu'il en a lu.
///
/// Les deux dates sont **personnelles** : ce que j'ai lu et ce que j'ai
/// retiré de ma vue ne regardent que moi. C'est le principe de tout ce lot —
/// personne n'efface rien chez autrui.
model Participation {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  utilisateurId  String
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  /// Jusqu'où ce membre a lu. Les non-lus sont les messages postérieurs dont
  /// il n'est pas l'auteur **et qui ne sont pas masqués pour lui** — cette
  /// dernière condition est ce qui empêche le corbeau d'une personne bloquée
  /// de faire sonner le compteur.
  luJusquau DateTime?

  /// « Supprimer la conversation », de sa vue seule. Les messages antérieurs
  /// disparaissent pour lui, le fil sort de sa liste — et y revient si l'autre
  /// réécrit, vidé de l'ancien. Sans ce retour, on pourrait faire disparaître
  /// quelqu'un de sa boîte pour de bon, et c'est un piège pour un membre
  /// harcelé qui ne verrait plus rien arriver.
  masqueeLe DateTime?

  rejointLe DateTime @default(now())

  @@unique([conversationId, utilisateurId])
  @@index([utilisateurId, masqueeLe])
  @@map("participations")
}

/// Un corbeau. Texte brut, échappé à l'affichage ; les retours à la ligne
/// sont conservés, les liens ne sont jamais rendus cliquables.
///
/// Pas de colonne `modifieLe` : **un corbeau parti ne se réécrit pas.** Pas
/// de sujet non plus — la Tour n'en a pas.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Nul si le compte a été supprimé depuis. Le fil reste lisible chez celui
  /// qui l'a reçu : effacer son compte n'efface pas ce qu'on a écrit chez
  /// autrui, exactement comme la suppression d'un message.
  auteurId String?
  auteur   Utilisateur? @relation("CorbeauxEnvoyes", fields: [auteurId], references: [id], onDelete: SetNull)

  corps String @db.Text

  envoyeLe DateTime @default(now())

  masques      MessageMasque[]
  signalements Signalement[]

  @@index([conversationId, envoyeLe])
  @@map("messages")
}

/// « Ce message est caché pour cette personne. »
///
/// **Une seule table pour deux règles**, et c'est ce qui les rend sûres :
///
///   SUPPRIME_PAR_SOI — j'ai retiré ce message de ma vue. La copie de l'autre
///                      est intacte : je n'ai touché ni au message ni à sa
///                      ligne à lui. C'est ce qui protège un membre harcelé
///                      dont l'agresseur voudrait effacer ses traces.
///   BLOQUE           — le message d'une personne bloquée. Il est bel et bien
///                      écrit, puis masqué pour le destinataire dans la même
///                      écriture. L'expéditeur voit son corbeau partir et le
///                      relit dans son fil : rien ne lui dit qu'il est bloqué.
///                      C'est délibéré — un refus explicite déclenche
///                      l'escalade, qui est le vrai risque.
model MessageMasque {
  id            String      @id @default(cuid())
  messageId     String
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  raison RaisonMasquage

  creeLe DateTime @default(now())

  @@unique([messageId, utilisateurId])
  @@index([utilisateurId])
  @@map("messages_masques")
}

enum RaisonMasquage {
  SUPPRIME_PAR_SOI
  BLOQUE
}

/// « Je ne veux plus rien recevoir de cette personne. »
///
/// Rien d'autre n'est stocké : ni motif, ni état. Tout le reste s'en déduit —
/// le fil clos côté bloqueur, le refus d'en ouvrir un nouveau, le masquage
/// automatique, l'absence du bloqué dans la recherche.
///
/// Un motif appellerait à en faire quelque chose, et bloquer ne doit rien
/// déclencher : signaler et bloquer sont deux gestes distincts.
model Blocage {
  id         String      @id @default(cuid())
  bloqueurId String
  bloqueur   Utilisateur @relation("BlocagesPoses", fields: [bloqueurId], references: [id], onDelete: Cascade)
  bloqueId   String
  bloque     Utilisateur @relation("BlocagesSubis", fields: [bloqueId], references: [id], onDelete: Cascade)

  creeLe DateTime @default(now())

  @@unique([bloqueurId, bloqueId])
  @@index([bloqueId])
  @@map("blocages")
}

/// Un signalement, et **la seule fenêtre du staff sur les échanges privés**.
///
/// Tout tient dans `contexte` : le message visé et une dizaine autour,
/// recopiés tels quels au moment du clic. Jamais la conversation entière,
/// jamais la boîte du membre.
///
/// Deux conséquences, et la seconde est l'essentiel :
///
///   1. Le message signalé survit à tout — à sa suppression par son auteur, à
///      l'effacement du compte, à celui du fil. Sans cela le signalement ne
///      servirait à rien.
///   2. **L'écran de modération n'a aucun besoin de lire `Message`.** Il lit
///      cette colonne, et rien d'autre. « Aucun membre du staff ne lit les
///      conversations privées » cesse d'être une intention à tenir : il
///      n'existe aucun chemin de `/admin` vers les messages, et un test le
///      vérifie en relisant le code source.
///
/// Art. 8.6 — les signalements sont confidentiels : la personne visée ne sait
/// jamais qui l'a signalée. `parId` ne quitte pas cette table.
model Signalement {
  id String @id @default(cuid())

  /// Pointeur vivant, pour le seul cas où le message existe encore. Ce n'est
  /// PAS la source de ce que lit la modération : `contexte` l'est.
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  parId  String?
  par    Utilisateur? @relation("SignalementsEnvoyes", fields: [parId], references: [id], onDelete: SetNull)
  viseId String?
  vise   Utilisateur? @relation("SignalementsRecus", fields: [viseId], references: [id], onDelete: SetNull)

  /// Facultatif — signaler doit rester un clic.
  motif String? @db.Text

  /// **La copie figée.** Un tableau JSON : auteur, date et texte de chaque
  /// message du contexte, celui qui est visé compris. Un déclencheur en
  /// interdit toute réécriture — une preuve qui se retouche n'en est pas une.
  contexte Json

  statut         StatutSignalement @default(EN_ATTENTE)
  traiteLe       DateTime?
  /// « Administration », tant que la zone d'administration n'est qu'un mot de
  /// passe partagé sans comptes distincts : le site n'a personne d'autre à
  /// nommer. Même convention que `roleAffichePosePar`.
  traitePar      String?
  noteTraitement String?           @db.Text

  creeLe DateTime @default(now())

  @@index([statut, creeLe])
  @@map("signalements")
}

enum StatutSignalement {
  EN_ATTENTE
  TRAITE
  CLASSE_SANS_SUITE
}

// ─────────────────────────────────────────────────────────────
//  Les pouvoirs — permissions attribuables et préfets
// ─────────────────────────────────────────────────────────────

/// **Les cinq permissions attribuables, et il n'y en aura pas d'autres sans
/// une décision explicite.**
///
/// Elles sont indépendantes de `Utilisateur.role` : la directrice du château
/// n'est pas modératrice du site, et peut pourtant écrire les annonces des
/// quatre maisons. Elles sont aussi indépendantes de `Eleve.roleAffiche`, qui
/// reste purement décoratif — un membre peut afficher « Directrice » sans
/// aucun pouvoir, et l'inverse.
///
/// **Aucune ne donne accès à la Tour aux Corbeaux.** Cette permission n'existe
/// pas, ne figure pas dans cette liste, pas même désactivée, et ne doit jamais
/// y entrer : personne ne lit les conversations privées, quel que soit son
/// rôle. `lib/forum/pouvoirs.test.ts` compte les valeurs de cet enum et
/// échoue à la sixième — pas pour interdire d'en ajouter une, mais pour que
/// personne ne le fasse sans s'en apercevoir.
///
/// **Aucune ne permet d'en attribuer**, non plus. Seule la zone
/// d'administration accorde et retire, et un test relit le code source pour
/// s'en assurer : sans quoi un professeur se promeut lui-même, ou promeut un
/// ami.
enum Permission {
  /// Portée : une maison. Écrire les annonces de cette maison.
  ANNONCES_MAISON
  /// Portée : une maison. Lire ses espaces réservés — dortoir compris.
  LIRE_ESPACES_MAISON
  /// Portée : tout le forum.
  CLORE_SCENE
  /// Portée : tout le forum.
  EPINGLER_SUJET
  /// Portée : tout le forum.
  VERROUILLER_SECTION
}

/// Une permission accordée à un membre, sur une maison ou sur tout le forum.
///
/// **Une ligne par maison, jamais un NULL qui voudrait dire « toutes ».**
/// « Les quatre maisons » s'écrit avec quatre lignes, posées dans une seule
/// transaction et retirées d'un seul clic. Le raccourci `maison = NULL` pour
/// « toutes » ferait porter deux sens à la même case — « toutes les maisons »
/// ici, « sans objet » là — et c'est exactement le piège contre lequel
/// `EtatEtape` a été inventé.
///
/// Deux garanties vivent en SQL et pas ici :
///   • un `CHECK` : permission de maison ⇔ `maison` renseignée ;
///   • **deux index uniques partiels**. Postgres tient deux NULL pour
///     distincts dans un index unique : un `@@unique` ordinaire laisserait
///     accorder `CLORE_SCENE` deux fois au même compte.
///
/// L'historique n'est pas ici : retirer une permission efface la ligne. Le
/// « qui, quoi, quand » vit dans `JournalMembre`, déjà indexé par membre et
/// déjà affiché sur sa fiche — deux histoires valent moins qu'une seule.
model PermissionAccordee {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  permission Permission

  /// Renseignée pour `ANNONCES_MAISON` et `LIRE_ESPACES_MAISON`, **nulle pour
  /// les trois autres** — un `CHECK` impose la correspondance dans les deux
  /// sens. Une permission de maison sans maison n'aurait pas de portée ; une
  /// permission globale avec une maison en aurait deux.
  maison Maison?

  accordeeLe  DateTime @default(now())
  /// « Administration », tant que la zone d'administration n'est qu'un mot de
  /// passe partagé sans comptes distincts. Même convention que
  /// `roleAffichePosePar` et `Signalement.traitePar`.
  accordeePar String

  @@index([utilisateurId])
  /// « Qui détient quoi ? » — la page d'ensemble lit par là.
  @@index([permission, maison])
  @@map("permissions_accordees")
}

/// Un préfet, et la maison dont il l'est.
///
/// Le droit d'écrire les annonces de cette maison **dérive** de cette table :
/// nommer un préfet ne crée aucune ligne dans `permissions_accordees`. Sans
/// quoi lui retirer le titre laisserait le pouvoir derrière lui, et personne
/// ne verrait pourquoi il écrit encore.
///
/// Plusieurs préfets par maison, et un même élève peut en être de plusieurs —
/// la contrainte n'interdit que de le nommer deux fois pour la même. La maison
/// n'est **pas** contrainte à être la sienne : c'est une décision du joueur,
/// pas un oubli.
///
/// La table reste vide au 26 août 2026. Le staff écrit les annonces depuis la
/// zone d'administration en attendant ; le jour où un préfet est nommé, il n'y
/// a rien à développer.
model Prefet {
  id      String @id @default(cuid())
  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  maison Maison

  nommeLe  DateTime @default(now())
  /// Même convention que `PermissionAccordee.accordeePar`.
  nommePar String

  @@unique([eleveId, maison])
  @@index([maison])
  @@map("prefets")
}

// ─────────────────────────────────────────────────────────────
//  Le forum — le moteur, et ses trois espaces
// ─────────────────────────────────────────────────────────────

/// Qui peut ouvrir un sujet ici.
enum QuiOuvreUnSujet {
  TOUT_MEMBRE
  /// Les membres de la maison à qui le lieu est réservé.
  MEMBRES_MAISON
  /// Les préfets de la maison et les détenteurs d'`ANNONCES_MAISON`.
  DETENTEUR_PERMISSION
  /// « Sur convocation » : le staff seul ouvre le sujet. L'élève convoqué
  /// répond — c'est tout l'intérêt, et c'est pourquoi ce n'est pas un lieu
  /// fermé.
  STAFF_SEULEMENT
}

/// Qui peut répondre dans un sujet ici.
///
/// **Il n'existe pas de valeur « selon le mode de participation ».** Le mode
/// d'une scène — libre, sur invitation, réservé — est une **convention entre
/// joueurs, écrite dans le titre**, et le site ne l'applique pas : c'est une
/// décision du joueur, prise le 26 août 2026. Une valeur d'enum qui prétendrait
/// le contraire finirait par servir à refuser un post.
enum QuiRepond {
  TOUT_MEMBRE
  MEMBRES_MAISON
}

/// Qui peut **lire** ce lieu. La lecture est presque toujours ouverte : une
/// scène verrouillée par l'année reste lisible, un dortoir aussi. Seul
/// l'espace d'une maison se ferme vraiment.
enum Visibilite {
  TOUS
  MAISON
}

/// Un espace du forum, et **ses paramètres**.
///
/// Trois espaces reposent sur le même moteur — le domaine, le monde des
/// non-mages, et celui d'une maison. Ce qui les distingue tient dans les
/// colonnes ci-dessous, jamais dans du code : construire trois fois le même
/// forum serait le meilleur moyen d'en avoir trois qui divergent.
model Espace {
  id String @id @default(cuid())

  /// Stable, et lue par les routes : « domaine », « non-mages », « maison ».
  /// Le nom, lui, peut changer sans casser une adresse.
  cle         String @unique
  nom         String
  description String @db.Text
  ordre       Int

  /// Le minimum de lignes d'un post. **Nul = aucune exigence.** Dix dans le
  /// domaine (art. 12.2), aucune ailleurs.
  lignesMinimum Int?

  quiOuvreUnSujet QuiOuvreUnSujet @default(TOUT_MEMBRE)
  quiRepond       QuiRepond       @default(TOUT_MEMBRE)

  /// **Le point d'accroche des points, et rien d'autre.** Les points n'existent
  /// pas ; le jour venu, ce booléen dira où l'on compte, et `maisonQuiCompte`
  /// dira pour qui. Lire `Eleve.maison` directement, c'est le bug.
  comptePourLesPoints Boolean @default(false)

  /// Les sujets d'ici comptent-ils dans les scènes simultanées (art. 17.3) ?
  /// **Le compte est affiché, jamais opposé** : la limite est un principe de
  /// confiance, pas un verrou — décision du joueur, 26 août 2026.
  compteLesScenes Boolean @default(false)

  visibilite Visibilite @default(TOUS)

  /// L'année minimale par défaut. Chaque lieu peut resserrer, jamais ouvrir.
  anneeMinimale Fonction?

  /// Fermé à l'écriture — sans rien cacher : ce qui s'y est joué reste lisible.
  ouvert Boolean @default(true)

  sections Section[]

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@index([ordre])
  @@map("espaces")
}

/// Une section, ou une sous-section : **la même table**.
///
/// « L'école » a besoin de trois niveaux — l'aile, la pièce, le sujet ; « Le
/// monde des non-mages » de deux. Une table auto-référente laisse les deux
/// coexister sans imposer la même profondeur partout.
///
/// **Deux niveaux au maximum**, et c'est la base qui le tient : un déclencheur
/// refuse un parent qui a déjà un parent. Sans lui, rien n'empêcherait une
/// arborescence que l'interface ne saurait pas dessiner.
///
/// **Une section ne peut que RESSERRER ce que l'espace a ouvert.** L'année, la
/// visibilité et l'ouverture se résolvent en prenant la plus stricte des deux
/// valeurs — voir `lib/forum/lieux.ts`. Une surcharge qui ouvrirait une porte
/// que l'espace ferme serait une porte dérobée.
model Section {
  id String @id @default(cuid())

  espaceId String
  espace   Espace @relation(fields: [espaceId], references: [id], onDelete: Cascade)

  /// Nul = section de premier niveau. Renseigné = sous-section.
  parentId String?
  parent   Section?  @relation("SousSections", fields: [parentId], references: [id], onDelete: Cascade)
  enfants  Section[] @relation("SousSections")

  /// Unique dans l'espace, et non par parent : les adresses restent plates,
  /// `/domaine/la-bibliotheque` plutôt que `/domaine/aile-est/la-bibliotheque`.
  /// Déplacer une pièce d'une aile à l'autre ne casse alors aucun lien.
  slug        String
  nom         String
  description String @db.Text
  ordre       Int

  /// Les resserrements. Nul = on garde ce que l'espace dit.
  anneeMinimale Fonction?

  /// **L'écriture** réservée à cette maison. La lecture, elle, reste ouverte —
  /// c'est ce qui fait les dortoirs : tout le monde lit, seule la maison écrit.
  maisonReservee Maison?

  /// « Sur convocation » se règle ici : c'est une propriété de la pièce, pas
  /// de l'espace. Nul = on garde ce que l'espace dit.
  quiOuvreUnSujet QuiOuvreUnSujet?

  visibilite Visibilite?

  ouverte Boolean @default(true)

  sujets Sujet[]

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@unique([espaceId, slug])
  @@index([espaceId, parentId, ordre])
  @@map("sections")
}

/// Un sujet — une scène, une annonce, une discussion.
///
/// **Pas de colonne `mode`.** Libre, sur invitation, réservé : le mode est
/// écrit dans le titre par le joueur, et le site ne l'applique pas. Une colonne
/// qui ne décide de rien finirait par décider de quelque chose — quelqu'un
/// écrirait une condition dessus, et le site refuserait des posts au nom d'une
/// règle qui devait tenir à la bonne foi.
model Sujet {
  id String @id @default(cuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  /// Ancré sur la **fiche** et non sur le compte : un post RP est écrit par un
  /// personnage. Nul si le compte a été supprimé — le sujet reste lisible.
  auteurId String?
  auteur   Eleve?  @relation("SujetsOuverts", fields: [auteurId], references: [id], onDelete: SetNull)

  /// Le mode de participation s'y écrit par convention : « Le vent sur la
  /// galerie (RÉSERVÉ Sigrid) ».
  titre String

  epingle Boolean   @default(false)
  closLe  DateTime?
  /// « Administration », ou le nom du modérateur le jour où il y en aura.
  closPar String?

  /// **Le verrouillage n'est pas rétroactif.** L'année exigée est recopiée à
  /// l'ouverture, et un déclencheur interdit de la réécrire : changer la règle
  /// d'un lieu ne referme pas une scène déjà en cours.
  anneeRequiseALOuverture Fonction?

  /// **Retirée du forum, jamais effacée.** Une scène supprimée disparaît des
  /// listes et de sa propre adresse, et reste entière en base : rien ne part
  /// définitivement sur un clic. Vaut pour l'auteur comme pour le staff —
  /// décision du joueur, 27 août 2026.
  ///
  /// `motifSuppression` est **obligatoire pour le staff** et vide pour un
  /// auteur qui retire sa propre scène : il n'a personne à qui se justifier.
  /// La base n'exige que la cohérence des deux premières colonnes ; le motif
  /// se réclame dans le dépôt.
  supprimeLe       DateTime?
  supprimePar      String?
  motifSuppression String?   @db.Text

  /// Dénormalisé et indexé — le tri « par activité récente ». Le recalculer à
  /// chaque affichage obligerait à balayer tous les posts de tous les sujets.
  /// Même raison que `Conversation.dernierMessageLe`.
  dernierPostLe DateTime @default(now())

  posts Post[]

  creeLe DateTime @default(now())

  @@index([sectionId, epingle, dernierPostLe])
  @@index([auteurId])
  @@map("sujets")
}

/// Un post.
///
/// Texte brut, rendu par React donc échappé d'office ; les retours à la ligne
/// sont conservés par `whitespace-pre-wrap`, jamais par une conversion en
/// `<br>` — qui obligerait à assembler du HTML à la main.
model Post {
  id String @id @default(cuid())

  sujetId String
  sujet   Sujet  @relation(fields: [sujetId], references: [id], onDelete: Cascade)

  auteurId String?
  auteur   Eleve?  @relation("PostsEcrits", fields: [auteurId], references: [id], onDelete: SetNull)

  corps String @db.Text

  /// Art. 16.3 — l'avertissement se met **en tête de post**, et se propose au
  /// moment de publier. Nul quand il n'y en a pas.
  avertissementContenu String?

  publieLe  DateTime  @default(now())
  modifieLe DateTime?

  /// Art. 19.3 — un post non conforme est masqué **le temps d'une correction**,
  /// pas supprimé. Les quatre colonnes vont ensemble ou pas du tout ; le joueur
  /// est prévenu par un corbeau du château et dispose de sept jours.
  masqueLe        DateTime?
  masquePar       String?
  motifMasquage   String?   @db.Text
  corrigerAvantLe DateTime?

  /// **Retiré par son auteur** — à ne pas confondre avec le masquage
  /// ci-dessus, qui est une mesure du staff et laisse le texte lisible à son
  /// auteur pour qu'il le reprenne (art. 19.3). Ici le texte n'est plus lu de
  /// personne, et reste en base.
  retireLe DateTime?

  /// La place est-elle gardée à l'écran ? Vrai quand un post plus récent
  /// existait au moment du retrait : une réponse qui suit un trou ne se
  /// comprend plus. **Tranché au moment du geste et gardé ici** — le
  /// recalculer donnerait une autre réponse le jour où quelqu'un écrit après
  /// coup, et le post reparaîtrait sans que personne l'ait demandé.
  placeConservee Boolean @default(false)

  /// Le point que ce post a rapporté, s'il en a rapporté un. **Au plus un,
  /// jamais deux** : la base le garantit par un index unique partiel, et non
  /// par une condition écrite quelque part dans une route.
  pointGagne PointGagne?

  @@index([sujetId, publieLe])
  @@index([auteurId])
  @@map("posts")
}

// ─────────────────────────────────────────────────────────────
//  Partie V — Les points, les saisons et le tournoi des maisons
//
//  **Deux compteurs, et il ne faut jamais les confondre :**
//
//    les points PERSONNELS — `Eleve.points`, la progression de l'élève, qui
//        traverse les années (art. 18.4)
//    les points de MAISON  — `CompteurMaison`, le tournoi et les tubes, remis
//        à zéro à chaque saison
//
//  Les deux se remplissent du même carnet — `PointGagne` — mais un ajustement
//  de l'administration ne touche que le second : une sanction jouée en RP
//  (art. 19.1) ne doit pas coûter son année à un élève.
//
//  **Le carnet est la seule vérité.** Les compteurs n'en sont qu'un résumé,
//  tenu à jour pour que les tubes s'affichent d'un coup, et reconstructible
//  entièrement depuis le carnet le jour où un total serait faux.
// ─────────────────────────────────────────────────────────────

/// Une année scolaire — six mois en temps réel (art. 18.3).
///
/// **Rien n'est jamais remis à zéro sur ce site**, et les compteurs ne font
/// pas exception : à la clôture, on n'efface pas, on ouvre une page neuve.
///
/// C'est ce qui permet à deux exigences de coexister : que les compteurs de
/// maison repartent de zéro chaque année, et qu'une commande sache les
/// reconstruire depuis le carnet. Sans saison, ce recalcul ramasserait toute
/// l'histoire et rendrait les points de l'an dernier.
///
/// **Une seule saison ouverte à la fois**, garanti par un index unique
/// partiel que Prisma ne sait pas exprimer — il vit dans la migration.
model SaisonScolaire {
  id  String @id @default(cuid())
  nom String

  ouverteLe DateTime  @default(now())
  /// Renseignée = la saison est close, son classement est archivé, et les
  /// points vont désormais dans la suivante.
  closeLe   DateTime?

  points      PointGagne[]
  ajustements AjustementMaison[]
  compteurs   CompteurMaison[]
  classement  ClassementArchive[]

  creeLe DateTime @default(now())

  @@map("saisons_scolaires")
}

/// D'où vient un point.
///
/// `QCM` et `EXAMEN` sont posés sans être employés : les cours n'existent pas
/// encore. C'est le point d'accroche, et le poser après coup obligerait à
/// retoucher un type que des milliers de lignes porteraient déjà.
enum SourcePoint {
  POST
  QCM
  EXAMEN

  /// **La main de l'administration** — art. 18.1 : « la qualité d'écriture »,
  /// la présence à un événement, une belle scène. Des choses qu'aucun compteur
  /// ne sait mesurer et qui se voient à la lecture.
  ///
  /// ⚠️ À ne pas confondre avec `AjustementMaison`, qui lui ressemble et ne
  /// fait pas la même chose : celui-ci vise UN ÉLÈVE et alimente les deux
  /// compteurs (art. 18.2), celui-là vise une maison et n'alimente que le sien.
  ADMINISTRATION
}

/// **Le contrôle d'une leçon, envoyé.** Un par élève et par leçon, jamais deux.
///
/// ⚠️ **Aucune question, aucune bonne réponse.** Elles vivent dans
/// `lib/cours/questionnaires.ts`, `server-only`, et ne descendent jamais dans
/// le navigateur avant l'envoi — même parti pris que le barème de la Cérémonie
/// du Miroir. Cette table ne porte que ce que l'élève a répondu, et ce que
/// cela valait.
///
/// ⚠️ **Il n'y a pas de brouillon en base.** La page dit « Brouillon
/// enregistré » ; ce brouillon vit dans l'onglet. Ce qui est écrit ici est un
/// contrôle ENVOYÉ, et l'envoi est définitif.
model ControleEnvoye {
  id String @id @default(cuid())

  /// La FICHE, et non le compte : un contrôle est passé par un personnage.
  /// Nulle si le compte a été supprimé — la ligne reste, comme au carnet.
  eleveId String?
  eleve   Eleve?  @relation(fields: [eleveId], references: [id], onDelete: SetNull)

  /// L'identifiant de matière du cursus — « sortileges », jamais son nom.
  /// Pas de clé étrangère : le cursus vit dans le code, il n'a pas de table.
  matiereId String
  /// L'année ET le rang : une matière porte plusieurs leçons par année, et
  /// une leçon 1 existe dans plusieurs années.
  annee     Int    @db.SmallInt
  rang      Int    @db.SmallInt

  /// Ce qu'il a répondu, dans l'ordre des questions — l'indice de la réponse
  /// **au questionnaire**, jamais celui de l'ordre affiché, qui est mélangé à
  /// chaque ouverture et ne veut rien dire hors de la page.
  reponses Int[] @db.SmallInt

  /// Le nombre de bonnes réponses, et le nombre de questions. Le second est
  /// figé lui aussi : un questionnaire qui gagnerait une question ne doit pas
  /// changer le sens des notes déjà données.
  note       Int @db.SmallInt
  surCombien Int @db.SmallInt

  /// **C'est elle qui fait courir les sept jours** avant la leçon suivante
  /// (`REGLES.delaiEntreLeconsJours`). Elle ne bouge plus — un déclencheur
  /// refuse toute réécriture de cette ligne.
  envoyeLe DateTime @default(now())

  /// Un seul envoi par élève et par leçon. ⚠️ **Partiel** : dans un index
  /// unique, deux NULL sont distincts, et l'index vit en SQL parce que Prisma
  /// ne sait pas l'exprimer. Voir la migration.
  @@index([eleveId, envoyeLe])
  @@map("controles_envoyes")
}

/// **Le carnet.** Une ligne par point gagné, et la seule vérité du lot.
model PointGagne {
  id String @id @default(cuid())

  saisonId String
  saison   SaisonScolaire @relation(fields: [saisonId], references: [id], onDelete: Restrict)

  /// La FICHE, et non le compte : un post RP est écrit par un personnage.
  /// Nulle si le compte a été supprimé — la ligne, elle, reste, et le
  /// compteur de la maison ne bouge pas. Un total qui baisserait parce que
  /// quelqu'un s'en va punirait sa maison de son départ.
  eleveId String?
  eleve   Eleve?  @relation(fields: [eleveId], references: [id], onDelete: SetNull)

  /// **Figée au moment du gain**, comme l'année d'un sujet à son ouverture.
  /// Elle n'est jamais relue sur la fiche, et c'est tout l'intérêt : une
  /// joueuse de Bryggeld nommée professeure quitte l'effectif sans que sa
  /// maison perde ce qu'elle a vraiment gagné pour elle.
  ///
  /// Nulle quand le compte ne marquait pour personne — `maisonQuiCompte`, et
  /// jamais la colonne `maison` de la fiche.
  maison Maison?

  /// Un aujourd'hui. La colonne existe pour que « un post vaut un point »
  /// reste un réglage, et non une vérité gravée dans la forme du carnet.
  points Int @default(1)

  source SourcePoint

  /// Le post qui l'a produit, ou nul pour les autres sources. L'accord entre
  /// les deux est tenu par la base, **dans les deux sens**.
  postId String? @unique
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Restrict)

  /// Pourquoi ce point a été accordé, et par qui.
  ///
  /// **Obligatoires pour `ADMINISTRATION`, interdits pour le reste** — la base
  /// tient les deux sens. Un point visible de tous ne doit jamais apparaître
  /// sans explication ; un point de post, lui, EST son explication, et son
  /// texte est lisible par tout le monde.
  motif  String? @db.Text
  parNom String?

  /// **Le point masqué.** Un post masqué le temps d'une correction
  /// (art. 19.3) cesse de rapporter, et le retrouve au démasquage. La ligne
  /// n'est pas effacée : elle porte une date et cesse de compter tant qu'elle
  /// la porte — c'est ce qui rend le geste réversible à l'identique.
  ///
  /// ⚠️ À ne pas confondre avec un post RETIRÉ, qui **garde** ses points —
  /// décision du joueur, 27 août 2026 : « les points acquis restent acquis »
  /// (art. 17.2). Retirer est le geste de l'auteur sur son propre texte ;
  /// masquer est une mesure du staff, temporaire.
  ///
  /// Elle sert aussi à **annuler un point accordé à la main** : là encore la
  /// ligne reste, et l'historique garde le geste et son retrait.
  repriseLe DateTime?

  gagneLe DateTime @default(now())

  @@index([eleveId, gagneLe])
  @@index([saisonId, maison])
  @@map("points_gagnes")
}

/// Un ajustement de l'administration — art. 19.1.
///
/// **Table séparée du carnet, et la séparation est la règle elle-même** : un
/// ajustement n'a pas d'élève, et ne touche QUE le compteur de la maison. Le
/// ranger dans le carnet le ferait tôt ou tard entrer dans les points
/// personnels par une somme distraite.
///
/// Ce sont des points visibles de tous : ils ne doivent jamais apparaître
/// sans explication. Le motif est donc obligatoire **en base**, pas seulement
/// à l'écran.
model AjustementMaison {
  id String @id @default(cuid())

  saisonId String
  saison   SaisonScolaire @relation(fields: [saisonId], references: [id], onDelete: Restrict)

  maison Maison

  /// Signé : un retrait est un nombre négatif. Deux colonnes « sens » et
  /// « nombre » diraient la même chose en deux endroits.
  points Int

  /// Affiché dans l'historique public de la maison.
  motif String @db.Text

  /// « L'Administration ». La zone d'administration n'a pas de comptes
  /// distincts : il n'y a personne d'autre à nommer. Même choix que
  /// `Sujet.closPar` et que `Eleve.roleAffichePosePar`.
  parNom String

  /// **Réversible sans effacement.** Annuler pose une date ; l'historique
  /// garde le geste ET son retrait. Un retrait de points qui disparaîtrait de
  /// l'historique serait pire qu'un retrait injuste.
  annuleLe  DateTime?
  annulePar String?

  creeLe DateTime @default(now())

  @@index([saisonId, maison, creeLe])
  @@map("ajustements_maison")
}

/// Le compteur d'une maison pour une saison — quatre lignes par saison.
///
/// Il n'apporte aucune vérité nouvelle : il évite seulement de refaire
/// l'addition de toute une saison à chaque bureau ouvert, et le bureau est la
/// page la plus visitée du site.
///
/// **Aucune contrainte `points >= 0`**, à dessein : le règlement fait perdre
/// des points (art. 18.6) et en retirer à une maison (art. 19.1) sans dire si
/// un total peut passer sous zéro. La poser trancherait à la place du joueur
/// une règle qu'il n'a pas écrite.
model CompteurMaison {
  id String @id @default(cuid())

  saisonId String
  saison   SaisonScolaire @relation(fields: [saisonId], references: [id], onDelete: Restrict)

  maison Maison
  points Int    @default(0)

  majLe DateTime @default(now()) @updatedAt

  @@unique([saisonId, maison])
  @@map("compteurs_maison")
}

/// Le classement d'une saison close — quatre lignes figées.
///
/// **Figées, jamais recalculées.** L'effectif de mars n'est pas celui
/// d'octobre, et un classement qui changerait après coup ne serait pas une
/// archive. Même principe que `Post.placeConservee` et que
/// `Sujet.anneeRequiseALOuverture` ; ici, c'est un déclencheur qui refuse
/// toute réécriture, sans exception.
///
/// La moyenne est recopiée telle quelle plutôt que redéduite des deux autres
/// colonnes : le plancher de trois élèves est un réglage, et il pourra
/// changer. Ce qui est archivé doit rester lisible avec les règles de son
/// époque.
model ClassementArchive {
  id String @id @default(cuid())

  saisonId String
  saison   SaisonScolaire @relation(fields: [saisonId], references: [id], onDelete: Restrict)

  maison   Maison
  points   Int
  effectif Int
  moyenne  Float

  /// De 1 à 4. **La maison gagnante est celle de rang 1** — pas de colonne
  /// « gagnante » : deux façons de dire la même chose finiraient par se
  /// contredire. Les ex æquo partagent leur rang, il n'est donc pas unique.
  rang Int

  figeLe DateTime @default(now())

  @@unique([saisonId, maison])
  @@map("classements_archives")
}

// ─────────────────────────────────────────────────────────────
//  Partie VI — Le Grand Hall
//
//  L'espace officiel de l'administration (bible §12) : « Règlement, annonces,
//  calendrier, résultats, événements à venir. Seul lieu officiel d'annonce.
//  **On y lit, on n'y débat pas.** »
//
//  Le préambule du règlement s'appuie dessus : une modification du règlement
//  y est affichée et « entre en vigueur sept jours après son affichage ».
//  C'est la seule promesse du site qui fasse courir un délai.
// ─────────────────────────────────────────────────────────────

/// Une annonce officielle du château.
///
/// **Une table à part, et non un quatrième espace de forum** — décision du
/// joueur, 28 août 2026. Le moteur du forum ne sait pas dire « personne ne
/// répond » : `QuiRepond` ne connaît que TOUT_MEMBRE et MEMBRES_MAISON, et
/// fermer le lieu ferait taire le staff avec les autres. Il aurait fallu lui
/// ajouter une valeur — une porte qu'on peut rouvrir par mégarde. Et une
/// annonce n'a ni année exigée, ni clôture, ni épinglage : autant de colonnes
/// vides, et une colonne qui ne décide de rien finit par décider de quelque
/// chose.
///
/// Sept garanties vivent dans `20260828100000_grand_hall` et nulle part
/// ailleurs — titre et corps non vides au sens de Postgres (`~
/// '[^[:space:]]'`, jamais `btrim`), leurs bornes, le retrait complet ou
/// absent, et **l'entrée en vigueur jamais antérieure à l'affichage**.
model Annonce {
  id String @id @default(cuid())

  titre String

  /// **En balisage**, comme un post : même liste blanche, même éditeur, même
  /// `nettoyerHtml` à l'enregistrement et à l'affichage. Une annonce qui ne
  /// pourrait pas poser un lien vers le règlement serait un pense-bête.
  corps String @db.Text

  /// La date d'AFFICHAGE — celle qui fait courir les sept jours du préambule.
  /// Elle ne bouge plus : antidater une annonce ferait courir un délai déjà
  /// écoulé.
  publieeLe DateTime @default(now())

  /// **Facultative.** Renseignée, l'écran annonce « En vigueur le
  /// 4 septembre » ; vide, l'annonce ne promet aucune date. Le site ne
  /// calcule rien et ne bloque rien : les sept jours sont une règle du
  /// joueur, pas un minuteur.
  entreeEnVigueurLe DateTime?

  /// « Modifié le », comme sur un post : une annonce est ce qu'on lit une
  /// fois, et l'on doit voir qu'elle a bougé depuis.
  modifieLe DateTime?

  /// **Retirer n'efface pas.** L'annonce sort du Grand Hall et du journal, et
  /// reste entière en base : ce qui a fait courir un délai doit rester
  /// consultable. Les deux colonnes vont ensemble ou pas du tout.
  retireeLe  DateTime?
  retireePar String?

  /// « Administration » — la zone d'administration n'a pas de comptes
  /// distincts, il n'y a personne d'autre à nommer. Même convention que
  /// `Eleve.roleAffichePosePar`.
  posePar String

  creeLe DateTime @default(now())

  @@index([publieeLe(sort: Desc)])
  @@map("annonces")
}

// ─────────────────────────────────────────────────────────────
//  Partie VII — Le tableau d'affichage d'une maison
// ─────────────────────────────────────────────────────────────

/// Un mot épinglé au tableau d'une maison.
///
/// **À ne pas confondre avec une `Annonce`** — celle du Grand Hall est
/// officielle, vaut pour tout le site, n'a pas d'auteur, et peut faire courir
/// les sept jours du préambule. Un mot de tableau n'engage rien, ne vaut que
/// pour une maison, et il est **signé**. Deux objets, deux tables.
///
/// **Aucune permission nouvelle** : qui l'écrit est déjà écrit dans
/// `peutEcrireLesAnnoncesDe` — le staff, le préfet de la maison, ou le
/// détenteur de `ANNONCES_MAISON`.
model MotDuTableau {
  id String @id @default(cuid())

  /// **Une maison, et jamais nulle.** Un `null` qui voudrait dire « toutes »
  /// ferait porter deux sens à la même case.
  maison Maison

  /// Du texte brut, 500 signes au plus — pas de balisage. Un tableau porte
  /// des mots, pas des articles.
  corps String @db.Text

  /// **Le mot est signé**, et c'est ce qui le distingue d'une annonce du
  /// Grand Hall. Nul quand le compte s'en va : le mot reste au mur.
  auteurId String?
  auteur   Eleve?  @relation(fields: [auteurId], references: [id], onDelete: SetNull)

  epingleLe DateTime @default(now())

  /// Retirer n'efface pas. ⚠️ `retirePar` est un **nom figé**, pas un lien —
  /// procédé de `Post.masquePar` : un identifiant serait vidé le jour où ce
  /// compte disparaît, et la contrainte « les deux ensemble » tomberait toute
  /// seule au milieu d'une suppression.
  retireLe  DateTime?
  retirePar String?

  @@index([maison, epingleLe(sort: Desc)])
  @@map("mots_du_tableau")
}

// ─────────────────────────────────────────────────────────────
//  Partie VIII — Le salon d'une maison
// ─────────────────────────────────────────────────────────────

/// Un message du salon d'une maison — la salle commune, en direct.
///
/// ⚠️ **Une PIÈCE, et non une correspondance.** « Le staff ne lit pas les
/// conversations privées » est une règle dure de ce site, tenue par
/// `etancheite.test.ts`, et **elle ne s'applique pas ici** : un salon se lit
/// comme un professeur traverse la salle commune. Sans cette distinction
/// écrite, la règle se déforme dans un sens ou dans l'autre.
///
/// Hors RP, comme la Tour aux Corbeaux : aucun minimum de lignes, aucun
/// avertissement de contenu, **aucun point**.
///
/// Le direct n'existe pas sur cette architecture — Vercel n'ouvre pas de
/// connexions permanentes. Le salon s'interroge toutes les quelques secondes
/// par `useRafraichissement` ; le jour où un WebSocket arriverait, c'est ce
/// fichier-là qui changerait, pas cette table.
model MessageSalon {
  id String @id @default(cuid())

  /// Une maison, et jamais nulle. Un salon commun se poserait un jour par une
  /// valeur de plus, jamais par un `null` qui voudrait dire « tout le monde ».
  maison Maison

  /// Mille signes au plus, texte brut.
  corps String @db.Text

  /// Signé. Nul quand le compte s'en va : le message reste dans la pièce.
  auteurId String?
  auteur   Eleve?  @relation(fields: [auteurId], references: [id], onDelete: SetNull)

  ecritLe DateTime @default(now())

  /// **Retirer n'efface pas** — c'est ce qui permet de retrouver une
  /// conversation pénible six mois plus tard. ⚠️ `retirePar` est un **nom
  /// figé**, jamais un lien : voir `MotDuTableau`.
  retireLe  DateTime?
  retirePar String?

  @@index([maison, ecritLe(sort: Desc)])
  @@index([auteurId, ecritLe(sort: Desc)])
  @@map("messages_salon")
}

/// La nature d'un événement du calendrier.
///
/// **Elle décide de quelque chose**, et c'est pourquoi elle existe : seule
/// `EPREUVE` remonte au bureau, sous « Prochaines épreuves ». Un panneau qui
/// annoncerait une fête sous ce titre se contredirait.
enum NatureEvenement {
  /// Examens, rites de passage, session d'épreuves finales (bible §9).
  EPREUVE

  /// La veillée des braises, la commémoration d'Einar — les temps forts.
  FETE

  /// Le rythme scolaire : rentrée, trimestres, clôture d'une année.
  SESSION
}

/// Un événement du calendrier — troisième feuille du Grand Hall (bible §12).
///
/// **« Calendrier » et « événements à venir » sont la même table** : le
/// calendrier montre tout, « à venir » est le filtre de ce qui n'a pas eu
/// lieu. Décision du joueur, 28 août 2026 — deux tables finiraient par dire
/// deux choses de la même fête.
model Evenement {
  id String @id @default(cuid())

  titre String

  /// **Du texte brut**, à la différence d'une annonce : un calendrier porte
  /// des repères, pas des articles, et l'éditeur inviterait à écrire long. Le
  /// détail va dans une annonce, qui a la barre complète. React échappe le
  /// texte d'office : aucune liste blanche à tenir de ce côté.
  description String @db.Text

  nature NatureEvenement

  /// La date qui classe. **Celle du monde réel** — décision du joueur : c'est
  /// ce qu'un joueur note dans son agenda, et la seule chose dont « à venir »
  /// et le panneau du bureau puissent se servir.
  ///
  /// ⚠️ Posée à **midi**, jamais à minuit : à minuit UTC, la moitié de la
  /// planète lirait la veille. Même précaution que `entreeEnVigueurLe`.
  debuteLe DateTime

  /// **Facultative** : un trimestre dure des mois, une veillée un soir.
  finitLe DateTime?

  /// « Modifié le », comme sur une annonce et sur un post.
  modifieLe DateTime?

  /// **Retirer n'efface pas.** Les deux colonnes vont ensemble ou pas du tout.
  retireLe  DateTime?
  retirePar String?

  /// « L'Administration » — pas de comptes distincts en zone d'administration.
  posePar String

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@index([debuteLe])
  @@map("evenements")
}

/// La suite donnée à une demande de partenariat.
///
/// **`EN_ATTENTE` n'est pas un état mou** : c'est le seul pour lequel
/// `traiteLe` est vide, et la base vérifie l'accord dans les deux sens. Une
/// demande « acceptée » sans date de traitement, ou datée sans décision,
/// serait une ligne dont personne ne saurait quoi faire six mois plus tard.
enum SuiteDemande {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

/// Un forum ami, affiché dans le bloc de liens de `/partenariat`.
///
/// **La page est publique, et c'est tout son objet** (bible §15) : les
/// partenariats croisés sont la première voie de recrutement, et un forum
/// démarcheur ne peut pas passer la connexion. C'est la seule table du site
/// dont le contenu s'affiche à qui n'a pas de compte.
///
/// **Les partenaires sortent dans l'ordre alphabétique**, jamais par date
/// d'ajout : un bloc de liens rangé par ancienneté classe des partenaires, et
/// personne n'a demandé de classement. Même parti pris que les quatre maisons,
/// qui sortent toujours dans l'ordre de `MAISONS`.
model Partenaire {
  id String @id @default(cuid())

  /// Le nom du forum, tel qu'il s'écrit chez lui.
  nom String

  /// Son adresse. **`https` seulement** — même règle que les images d'un
  /// post : le site ne renvoie pas ses visiteurs sur du trafic en clair.
  ///
  /// ⚠️ Un **index unique PARTIEL** l'empêche de figurer deux fois au bloc,
  /// sans interdire de renouer avec un partenaire retiré — le retrait
  /// n'efface pas, sa ligne reste. Prisma ne sait pas exprimer un index
  /// partiel : il vit en SQL, et seulement là. Cousin du piège des `NULL`
  /// déjà payé sur `permissions_accordees`.
  url String

  /// L'adresse de SA bannière, chez lui. **Facultative** : un partenaire qui
  /// n'en a pas s'affiche en lien, et attendre une image bloquerait l'échange.
  ///
  /// Rien n'est recopié chez nous — l'image reste chez son hébergeur, et
  /// disparaît du bloc le jour où il ferme. Même choix que les images d'un
  /// post.
  banniereUrl String?

  /// Une ligne pour dire ce qu'on y joue. Facultative.
  description String?

  /// Le jour où le partenariat a été noué. Saisi, jamais deviné : on renoue
  /// parfois avec un forum connu depuis des années.
  noueLe DateTime

  /// « Modifié le », comme sur une annonce.
  modifieLe DateTime?

  /// **Retirer n'efface pas.** Un partenariat rompu sort du bloc ; la ligne
  /// reste, et « Remettre » existe pour que le clic malheureux ne soit pas
  /// définitif. Les deux colonnes vont ensemble ou pas du tout.
  retireLe  DateTime?
  retirePar String?

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  @@index([nom])
  @@map("partenaires")
}

/// Ce que le formulaire public de `/partenariat` dépose.
///
/// ⚠️ **Le seul formulaire du site ouvert à qui n'a pas de compte**, et donc
/// la seule porte à spam. Trois freins, aucun service tiers : un pot de miel,
/// un délai minimal de remplissage, et un plafond horaire lu sur `recuLe`.
///
/// **Aucune adresse IP n'est conservée**, pas même sous forme d'empreinte : la
/// politique de confidentialité l'écrit noir sur blanc, et une page qui ment
/// est pire qu'absente. Le plafond est donc global — un robot acharné peut
/// fermer le formulaire une heure, et la page dit alors d'écrire sur Discord.
model DemandePartenariat {
  id String @id @default(cuid())

  /// Le nom de leur forum, leur adresse, et de quoi leur répondre.
  nomDuForum String
  url        String
  courriel   String

  /// Ce qu'ils écrivent. Obligatoire : une demande sans un mot n'apprend rien,
  /// et le champ vide est ce qu'un robot remplit le mieux.
  message String @db.Text

  /// La suite donnée. **Accordée avec `traiteLe` dans les deux sens** par la
  /// base : `EN_ATTENTE` exige une date vide, toute autre valeur l'exige
  /// pleine.
  suite    SuiteDemande @default(EN_ATTENTE)
  traiteLe DateTime?

  recuLe DateTime @default(now())

  @@index([recuLe(sort: Desc)])
  @@map("demandes_partenariat")
}

// ═════════════════════════════════════════════════════════════
//  Les Grimoires — la bibliothèque de consultation
// ═════════════════════════════════════════════════════════════

/// **Qui lit un chapitre.** Deux valeurs, et pas trois.
///
/// Le joueur a tranché le 30 août 2026 : **tout est lisible**. L'année d'un
/// sort s'affiche sur sa fiche — l'article 14.4 interdit de le LANCER hors de
/// son année, pas d'en lire le nom —, et elle ne ferme aucune porte. Une
/// troisième valeur « à partir de la Ne année » ne déciderait donc de rien
/// aujourd'hui, et une valeur qui ne décide de rien finit par décider de
/// quelque chose.
///
/// Le jour où un volume devrait vraiment se fermer, ce sera une valeur de
/// plus **et une migration** : Postgres ne sait pas ajouter une valeur d'enum
/// depuis le code.
enum AccesGrimoire {
  /// Tout membre entrant dans l'école.
  TOUS

  /// **Ne descend jamais dans le navigateur d'un joueur** — ni le contenu, ni
  /// le titre du chapitre, ni sa ligne au sommaire. Les quatre sortilèges
  /// interdits (art. 13.2 et 13.3) sont là.
  ADMINISTRATION
}

/// Ce qu'un bloc porte. La forme de `donnees` en dépend, et
/// `grimoires/schema.ts` est la seule porte qui la vérifie.
enum TypeBlocGrimoire {
  /// Du balisage, nettoyé par la liste blanche du site — la seule.
  PARAGRAPHE

  /// Un titre à l'intérieur d'un chapitre : « Quatrième année · 6 sorts ».
  /// C'est lui qui peuple le second niveau du sommaire, déduit et non tenu.
  SOUS_TITRE

  /// Le bloc riche : nom, glyphes, formule, matière, année, effet, limite.
  /// **Ne se coupe jamais** entre deux pages — mais cela se joue à l'écran,
  /// pas ici.
  FICHE_SORT

  /// L'un des quatre. Pas de rune, pas de formule : un verbe.
  ///
  /// ⚠️ **Un déclencheur lui interdit tout chapitre qui ne soit pas
  /// `ADMINISTRATION`**, dans les deux sens : on ne peut ni le poser dans un
  /// chapitre ouvert, ni ouvrir un chapitre qui en contient un.
  FICHE_INTERDITE

  /// Les vingt-quatre runes : des en-têtes et des lignes.
  TABLEAU

  /// Un blanc qui sépare. Ne porte rien.
  SEPARATEUR
}

/// La teinte du dos, sur l'étagère. Une liste courte plutôt qu'une couleur
/// libre : les quatre se dessinent dans la feuille de style, et un volume ne
/// peut pas arriver avec une couleur qui jure avec le reste.
enum ReliureGrimoire {
  CUIR_SOMBRE
  CUIR_FAUVE
  TOILE_BLEUE
  PARCHEMIN
}

/// **Un volume.** Le premier est le grimoire des Sortilèges ; le bestiaire,
/// l'histoire et l'herboristerie suivront dans le même format.
///
/// ⚠️ **À ne pas confondre avec « La bibliothèque »**, qui est une pièce de
/// l'aile ouest où l'on joue des scènes. Ici on lit ; là-bas on écrit. Le
/// vocabulaire les sépare : un grimoire se **consulte**, il ne s'habite pas.
model Grimoire {
  id String @id @default(cuid())

  /// L'adresse : `/grimoires/sortileges`. Minuscules, chiffres et tirets —
  /// la base le vérifie.
  slug String @unique

  titre String

  /// La ligne sous le titre, dans le lecteur : « Vingt-quatre runes ·
  /// soixante-cinq sorts · quatre interdits ». Facultative.
  exergue String?

  /// La ligne qu'on lit sur l'étagère, avant d'ouvrir.
  description String

  reliure ReliureGrimoire

  /// Sa place sur l'étagère. Pas d'unicité : deux volumes qui échangent leur
  /// rang le font dans une transaction, et un index unique s'y opposerait.
  ordre Int

  /// « Administration » — la zone d'administration n'a pas de comptes
  /// distincts. Même convention que `Annonce.posePar`.
  posePar String

  modifieLe DateTime?

  /// **Retirer n'efface pas.** Le volume sort de l'étagère et reste entier :
  /// « Remettre » existe pour que le clic malheureux ne soit pas définitif.
  /// Les deux colonnes vont ensemble ou pas du tout.
  retireLe  DateTime?
  retirePar String?

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  chapitres ChapitreGrimoire[]

  @@index([ordre])
  @@map("grimoires")
}

/// **Un chapitre, et un seul niveau.**
///
/// Le document du joueur porte deux niveaux de titres ; le second devient un
/// bloc `SOUS_TITRE` dans le flux, et le sommaire le retrouve. Deux niveaux
/// de chapitres auraient demandé le déclencheur du forum — « deux niveaux et
/// jamais trois » — pour un besoin que personne n'a.
///
/// C'est aussi ce qui fait tomber juste la condition d'accès : « Les quatre
/// sorts interdits » est un chapitre entier.
model ChapitreGrimoire {
  id String @id @default(cuid())

  grimoireId String
  grimoire   Grimoire @relation(fields: [grimoireId], references: [id], onDelete: Cascade)

  /// La seconde moitié de l'adresse : `/grimoires/sortileges/les-sorts-lies`.
  slug  String
  titre String
  ordre Int

  /// **La seule question que le filtrage serveur pose.**
  acces AccesGrimoire @default(TOUS)

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  blocs BlocGrimoire[]

  @@unique([grimoireId, slug])
  @@index([grimoireId, ordre])
  @@map("chapitres_grimoire")
}

/// **Un bloc.** Le contenu d'un volume est une suite de blocs, dans l'ordre —
/// jamais un pavé de HTML libre : c'est ce qui permet au lecteur de remplir
/// ses pages en mesurant, sans couper une fiche en deux.
model BlocGrimoire {
  id String @id @default(cuid())

  chapitreId String
  chapitre   ChapitreGrimoire @relation(fields: [chapitreId], references: [id], onDelete: Cascade)

  ordre Int
  type  TypeBlocGrimoire

  /// Le contenu, selon le type. **`grimoires/schema.ts` est la seule porte**
  /// par laquelle il entre en base — la base, elle, ne garantit que la forme
  /// générale : un objet, jamais une liste ni un nombre.
  donnees Json

  /// L'ancre d'un lien précis : `…/les-sorts-lies#sortilege-de-la-charge`.
  ///
  /// ⚠️ **C'est elle qui voyage dans un corbeau, jamais un numéro de page.**
  /// La pagination dépend de la largeur de l'écran et de la taille du texte :
  /// « page 12 » ne désigne pas le même contenu chez deux lecteurs.
  ancre String?

  @@unique([chapitreId, ancre])
  @@index([chapitreId, ordre])
  @@map("blocs_grimoire")
}

// ─────────────────────────────────────────────────────────────
//  Les erreurs du serveur — la trace que La Veille relit
// ─────────────────────────────────────────────────────────────

/// Une erreur survenue côté serveur, gardée le temps d'être vue.
///
/// ── Pourquoi une table, alors que Vercel a des journaux ──
///
/// Parce qu'ils ne durent pas. Selon la formule, les journaux d'exécution de
/// Vercel se gardent quelques heures — moins que les vingt-quatre que La Veille
/// doit couvrir —, et leur lecture dépend d'un jeton et d'un plan. Une table
/// tient la promesse sans dépendre d'aucun réglage d'hébergeur.
///
/// **Ceci ne remplace pas `console.error`, cela s'y ajoute.** Les journaux de
/// Vercel gardent leur usage — on y regarde en direct quand quelque chose brûle.
///
/// ── Ce qui n'y entre jamais ──
///
/// ⚠️ **Aucune adresse de courriel, aucun texte de membre.** Le message et la
/// pile sont CAVIARDÉS à l'écriture par `lib/erreurs/depot.ts`, pas à la
/// lecture : une adresse effacée au moment de l'affichage serait quand même
/// passée par la base, et la politique de confidentialité promet qu'elle n'y
/// est pas. Ce qui n'est jamais écrit ne fuit pas.
///
/// ── Ce que la base tient elle-même ──
///
/// La portée, le type et le message ne sont jamais vides au sens de Postgres
/// (`~ '[^[:space:]]'`, jamais `btrim`, qui ne retire que les espaces), et une
/// ligne **ne se réécrit pas** : c'est une trace. Elle peut être effacée — la
/// rétention l'exige —, jamais remplacée. Même principe que le carnet des
/// points et que la copie d'un signalement.
model ErreurServeur {
  id String @id @default(cuid())

  /// D'où elle vient : « connexion », « dossier », « courriel »… C'est le
  /// préfixe que les `console.error` du site portent déjà entre crochets.
  portee String

  /// Le nom de la classe d'erreur — `PrismaClientKnownRequestError`, `TypeError`.
  /// C'est lui qui sert à REGROUPER : cinquante fois la même erreur font une
  /// ligne dans le rapport, pas cinquante.
  type String

  /// Le code, quand il y en a un : `P2028` de Prisma, `ECONNREFUSED` de Node.
  code String?

  /// Le message, caviardé. Borné : une erreur bavarde ne doit pas peser.
  message String @db.Text

  /// La route où c'est arrivé, quand on la connaît.
  chemin String?

  survenuLe DateTime @default(now())

  /// Groupé par type, sur une fenêtre de temps : c'est exactement la requête
  /// que fait la ronde, tous les matins.
  @@index([survenuLe])
  @@index([portee, type, survenuLe])
  @@map("erreurs_serveur")
}
