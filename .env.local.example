# Variables d'environnement de Ravenshallow
#
# Copier ce fichier en `.env.local` (ignoré par git) et compléter les valeurs.
# Les mêmes variables doivent être déclarées sur Vercel :
# Project Settings → Environment Variables.

# ── Zone d'administration ─────────────────────────────────────
# Mot de passe unique de /admin. Lu uniquement côté serveur.
# Transitoire : sera remplacé par le rôle ADMIN sur un compte.
ADMIN_PASSWORD=

# ── Base de données (PostgreSQL) ──────────────────────────────
# Chaîne de connexion Prisma. Neon, Supabase ou tout Postgres.
DATABASE_URL=

# ── Authentification (Auth.js v5) ─────────────────────────────
# Secret de signature des sessions. Générer avec : npx auth secret
AUTH_SECRET=

# ── Stockage des portraits (Vercel Blob) ──────────────────────
# Jeton du store Blob, onglet Storage du projet Vercel.
BLOB_READ_WRITE_TOKEN=

# ── Courriels (SMTP Gmail) ────────────────────────────────────
# L'adresse d'envoi. Un service transactionnel tiers ne peut pas envoyer
# depuis une adresse @gmail.com : on passe donc par le SMTP de Google.
MAIL_EXPEDITEUR=ravenshallow.rp@gmail.com

# Mot de passe d'application Google (16 caractères), PAS le mot de passe du
# compte. À créer sur https://myaccount.google.com/apppasswords — la
# validation en deux étapes doit être activée au préalable.
# Sans lui, en développement, les courriels sont écrits dans la console.
MAIL_APP_PASSWORD=

# Adresse publique du site, pour les liens des courriels.
# Sur Vercel, elle est déduite automatiquement si absente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── La Veille (surveillance quotidienne) ──────────────────────
# Ces trois-là ne servent QU'À LA RONDE, jamais au site. Elles sont posées
# par deux scripts, qui écrivent aussi une note hors du dépôt à recopier dans
# les secrets GitHub :
#
#   node scripts/veille-identifiants.mjs   → VEILLE_DATABASE_URL
#   node scripts/veille-compte.mjs         → VEILLE_COURRIEL, VEILLE_MOT_DE_PASSE
#
# La chaîne de connexion du rôle `veille_lecture`, qui ne sait que lire.
# ⚠️ Jamais celle du propriétaire : `en-base.essai.ts` demande à la base qui
# parle et s'arrête net si ce n'est pas le bon rôle — mais il vaut mieux ne
# pas compter là-dessus.
VEILLE_DATABASE_URL=

# Le compte de service qui traverse les écrans. Aucune permission, invisible
# du Registre et de la Tour, et il ne publie jamais rien.
VEILLE_COURRIEL=veille@ravenshallow.invalid
VEILLE_MOT_DE_PASSE=

# La clé d'API Claude, pour la section « Suggestions » du rapport.
#
# ⚠️ FACULTATIVE. Sans elle, la ronde part quand même et le rapport dit
# simplement que la synthèse manque : c'est un confort, pas une condition.
#
# À créer sur https://console.anthropic.com → Settings → API keys.
# Elle commence par « sk-ant- ». Coût : quelques centimes par mois — le
# rapport fait moins de mille mots, une fois par jour.
ANTHROPIC_API_KEY=

# ── Réglages facultatifs de la ronde ──────────────────────────
# Le site à surveiller. Par défaut https://ravenshallow.com ; utile pour
# essayer la ronde contre le poste de développement :
#   VEILLE_SITE_URL=http://localhost:3000 npm run veille
VEILLE_SITE_URL=

# Où le rapport arrive. Par défaut, MAIL_EXPEDITEUR — le site s'écrit à
# lui-même, et il n'y a rien de plus à configurer.
VEILLE_DESTINATAIRE=
